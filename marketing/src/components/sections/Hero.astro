---
import { EmailForm } from '../EmailForm.tsx';
---

<section
  id="top"
  class="relative isolate flex flex-col justify-center overflow-hidden"
  style="min-height:calc(100svh - 52px)"
  data-section="hero"
>
  {/* Giant dumbbell watermark — single bold visual gesture, bleeds bottom-right */}
  <div class="hero-watermark" aria-hidden="true">
    <img src="/logo.svg" alt="" />
  </div>

  <div class="relative z-10 mx-auto w-full max-w-6xl px-5 sm:px-8 py-16 md:py-24">
    {/* Brand mark — icon + wordmark, dominant hero size */}
    <div class="flex items-center gap-5 mb-8">
      <button
        type="button"
        class="hero-logo-burst"
        aria-label="Animate CurlBro logo"
        data-logo-burst
        data-logo-burst-frames="/logo-burst/logo-rest.png,/logo-burst/logo-flex-01.png,/logo-burst/logo-flex-02.png,/logo-burst/logo-flex-03.png,/logo-burst/logo-flex-02.png,/logo-burst/logo-flex-01.png,/logo-burst/logo-rest.png"
      >
        <img
          src="/logo-burst/logo-rest.png"
          alt=""
          width="293"
          height="240"
          class="block"
          draggable="false"
          decoding="async"
          fetchpriority="high"
        />
      </button>
      <h1
        class="display-heading text-[var(--text-primary)] leading-none"
        style="font-size:clamp(3.5rem, 11vw, 8.5rem); letter-spacing:-0.025em"
      >
        CurlBro
      </h1>
    </div>

    {/* Thin cyan accent rule */}
    <span class="hairline mb-6" aria-hidden="true"></span>

    {/* Tagline — smaller now, lets the brand mark dominate */}
    <p
      class="mb-12 text-[var(--text-secondary)] [text-wrap:balance]"
      style="font-size:clamp(1.125rem, 2vw, 1.625rem); font-family:var(--font-body)"
    >
      Plan, lift, log, repeat.
    </p>

    {/* Primary CTAs side-by-side: App Store + email list */}
    <div class="flex flex-wrap items-center gap-3">
      <a
        href="https://apps.apple.com/us/app/curlbro/id6762241598"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
        aria-label="Open CurlBro in the App Store (opens in new tab)"
      >
        <svg
          width="17"
          height="17"
          viewBox="0 0 384 512"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5c0 26.2 4.8 53.3 14.4 81.2 12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
        </svg>
        Open in App Store
      </a>
      <button
        type="button"
        class="btn btn-ghost"
        aria-controls="hero-form-wrap"
        aria-expanded="false"
        data-form-reveal-trigger
      >
        Get on email list
      </button>
    </div>

    {/* Secondary: open the web app */}
    <div class="mt-4">
      <a href="/app/" class="hero-textlink">Open web app</a>
    </div>

    {/* Form reveal — hidden by default; click 'Get updates' to expand */}
    <div
      id="hero-form-wrap"
      class="email-form-wrap mt-8 max-w-lg"
      data-form-reveal-wrap
    >
      <div class="email-form-inner pt-2 pb-2">
        <EmailForm client:load />
      </div>
    </div>
  </div>
</section>
